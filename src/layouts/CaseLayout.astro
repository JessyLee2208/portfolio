---
// 案例頁版型：封面＋標題＋摘要＋專案資訊，內文左側有目錄（電腦版），底部下一篇
import Base from './Base.astro';
import LockGate from '../components/LockGate.astro';
import { langOf, lurl } from '../lib/i18n.js';
interface TocItem { id: string; label: string; }
interface MetaItem { label: string; value: string; }
interface Props {
  title: string; description: string; kicker: string; lead: string;
  meta: MetaItem[]; toc: TocItem[];
  tone: 'rust' | 'green' | 'mustard';
  next?: { href: string; title: string };
  locked?: boolean;   // 要密碼才看得到（見 LockGate）
}
const { title, description, kicker, lead, meta, toc, tone, next, locked = false } = Astro.props;
const L = langOf(Astro.url), en = L === 'en';
---
<Base title={`${title} · Jessy Lee`} description={description} noindex={locked}>
  {locked && <LockGate />}
  <article class:list={['case', `tone-${tone}`]}>
    <header class="wrap case-head">
      <a class="back" href={lurl(L, '/#works')}>{en ? '← All work' : '← 回到作品'}</a>
      <p class="label">{kicker}</p>
      <h1>{title}</h1>
      <p class="lead" set:html={lead} />
      <dl class="meta">
        {meta.map((m) => <div><dt class="label">{m.label}</dt><dd>{m.value}</dd></div>)}
      </dl>
      <div class="hero-media"><slot name="hero" /></div>
    </header>

    <div class="wrap case-body">
      <nav class="toc" aria-label={en ? 'On this page' : '本頁目錄'}>
        <p class="label">{en ? 'Contents' : '目錄'}</p>
        <ol>{toc.map((t) => <li><a href={`#${t.id}`} data-toc={t.id}>{t.label}</a></li>)}</ol>
      </nav>
      <div class="prose"><slot /></div>
    </div>

    {next && (
      <nav class="wrap case-next" aria-label={en ? 'Next case study' : '下一篇'}>
        <p class="label">{en ? 'Next' : '下一篇'}</p>
        <a href={next.href}>{next.title} →</a>
      </nav>
    )}
  </article>
</Base>

<style>
  .case { --tone: var(--rust); --tone-soft: var(--rust-soft); --tone-ink: var(--rust-ink); }
  .case.tone-green { --tone: var(--accent); --tone-soft: var(--accent-soft); --tone-ink: var(--accent); }
  .case.tone-mustard { --tone: var(--mustard); --tone-soft: var(--mustard-soft); --tone-ink: var(--mustard-ink); }

  .case-head { padding-top: 32px; }
  .back { display: inline-flex; align-items: center; min-height: 44px; margin-bottom: 14px; color: var(--muted); text-decoration: none; font-size: 14px; }
  .back:hover { color: var(--ink); }
  .case-head h1 { font-size: clamp(32px, 5vw, 52px); margin: 8px 0 0; }
  .hero-media :global(.fig) { margin: 40px 0 0; }
  .lead { margin: 24px 0 0; max-width: 46em; font-size: clamp(18px, 2.2vw, 21px); line-height: 1.75; font-weight: 700; padding-left: 18px; border-left: 4px solid var(--tone); }
  .meta { display: grid; grid-template-columns: repeat(auto-fit, minmax(180px, 1fr)); gap: 16px 24px; margin: 32px 0 0; padding: 20px 0; border-block: 1px solid var(--line); }
  .meta dt { margin-bottom: 6px; }
  .meta dd { margin: 0; font-size: 15px; line-height: 1.6; }

  .case-body { display: grid; gap: 40px; margin-top: 56px; }
  @media (min-width: 1080px) { .case-body { grid-template-columns: 180px minmax(0, 1fr); gap: 56px; } }
  .toc { display: none; }
  @media (min-width: 1080px) {
    .toc { display: block; position: sticky; top: 96px; align-self: start; }
    .toc ol { list-style: none; padding: 0; margin: 12px 0 0; display: grid; gap: 4px; border-left: 2px solid var(--line); }
    .toc a { display: block; padding: 4px 0 4px 14px; margin-left: -2px; border-left: 2px solid transparent; color: var(--muted); text-decoration: none; font-size: 14px; line-height: 1.5; }
    .toc a:hover { color: var(--ink); }
    .toc a.on { color: var(--ink); font-weight: 700; border-left-color: var(--tone); }
  }

  /* 內文 */
  .prose { max-width: var(--read); min-width: 0; }
  .prose :global(h2) { font-size: clamp(24px, 3vw, 30px); margin: 72px 0 16px; scroll-margin-top: 88px; }
  .prose :global(h2:first-child) { margin-top: 0; }
  .prose :global(h3) { font-size: 20px; margin: 40px 0 10px; scroll-margin-top: 88px; }
  .prose :global(p) { margin: 0 0 14px; }
  .prose :global(ul) { padding-left: 1.2em; margin: 0 0 16px; }
  .prose :global(li) { margin-bottom: 6px; }
  .prose :global(strong) { font-weight: 700; }
  .prose :global(.hl) { color: var(--tone-ink); font-weight: 700; }
  .prose :global(.tag-q) { display: inline-block; font: 700 14px/1 var(--f-mono); color: var(--tone-ink); background: var(--tone-soft); padding: 6px 10px; border-radius: 6px; margin-bottom: 6px; }
  .prose :global(.for) { display: inline-block; font-size: 13px; color: var(--muted); background: var(--sheet); border: 1px solid var(--line); border-radius: 99px; padding: 4px 12px; margin: 0 0 12px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 56px 0; }
  .prose :global(table) { width: 100%; border-collapse: collapse; margin: 20px 0 24px; font-size: 15px; line-height: 1.65; background: var(--sheet); border-radius: 12px; overflow: hidden; box-shadow: 0 0 0 1px var(--line); }
  .prose :global(th) { text-align: left; font-weight: 700; background: var(--tone-soft); padding: 10px 14px; }
  .prose :global(td) { padding: 10px 14px; border-top: 1px solid var(--line); vertical-align: top; }
  /* 第一欄可以換行（長句不會把第二欄擠成一直條），但至少 7 字寬，短標籤不會斷 */
  .prose :global(th:first-child), .prose :global(td:first-child) { min-width: 7em; }
  @media (max-width: 560px) { .prose :global(table) { font-size: 14px; } .prose :global(td), .prose :global(th) { padding: 8px 10px; } }
  /* 圖解、對照可以比內文寬 */
  /* 往左只能凸出 40px：左邊目錄和內文中間只有 56px，凸太多會蓋到目錄的字 */
  @media (min-width: 1080px) { .prose :global(.dg), .prose :global(.pc) { width: calc(100% + 80px); margin-left: -40px; } }

  .case-next { margin-top: 96px; padding-top: 32px; border-top: 1px solid var(--line); }
  .case-next a { display: inline-block; margin-top: 8px; font-size: clamp(22px, 3vw, 28px); font-weight: 900; color: var(--ink); text-decoration: none; }
  .case-next a:hover { color: var(--tone-ink); }
</style>

<script>
  // 目錄：標出目前讀到的段落
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a[data-toc]'));
  const heads = links.map((a) => document.getElementById(a.dataset.toc!)).filter(Boolean) as HTMLElement[];
  if (heads.length) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (e.isIntersecting) links.forEach((a) => a.classList.toggle('on', a.dataset.toc === e.target.id));
      });
    }, { rootMargin: '-20% 0px -70% 0px' });
    heads.forEach((h) => io.observe(h));
  }
</script>
