  /* 競品表：手機可左右滑；本次參考的三個產品欄位加底色 */
  .tw { overflow-x: auto; margin: 20px 0 24px; }
  .tw :global(table.comp) { min-width: 680px; margin: 0; font-size: 14px; text-align: center; table-layout: fixed; }
  .tw :global(table.comp th:first-child) { width: 8.5em; min-width: 0; }
  .comp th, .comp td { text-align: center; vertical-align: middle; }
  .comp tbody th { text-align: left; white-space: nowrap; }
  .comp .ref { background: color-mix(in srgb, var(--tone-soft) 70%, transparent); font-weight: 600; }
  .comp small { color: var(--muted); font-weight: 400; }
  .comp caption { caption-side: bottom; padding-top: 10px; font-size: 13px; color: var(--muted); }
  .center { text-align: center; }
  .tag-b, .tag-a { display: inline-block; font: 700 12px/1 var(--f-mono); padding: 5px 8px; border-radius: 6px; margin-right: 8px; vertical-align: 1px; }
  .tag-b { background: var(--line); color: var(--muted); }
  .tag-a { background: var(--tone-soft); color: var(--tone-ink); }
