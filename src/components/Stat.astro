---
interface Props { value: string; label: string; note?: string; }
const { value, label, note } = Astro.props;
---
<div class="stat reveal">
  <p class="value display num">{value}</p>
  <p class="lab">{label}</p>
  {note && <p class="snote">{note}</p>}
</div>
<style>
  .stat { background: var(--sheet); border: 1px solid var(--line); border-radius: var(--radius); padding: 20px; }
  .value { font-size: clamp(32px, 6vw, 48px); color: var(--tone-ink, var(--accent)); margin: 0; }
  .lab { margin: 6px 0 0; font-weight: 700; line-height: 1.5; }
  .snote { margin: 6px 0 0; font-size: 13px; color: var(--muted); line-height: 1.6; }
</style>
