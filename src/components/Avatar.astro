---
// Jessy 手繪頭像（Jessy 自己畫的，原檔在 _notion-raw/avatar，用 scripts/build-avatar.py 對齊輸出到 public/avatar）
// 六個表情疊在一起，用 data-expr 切換顯示。編號：0 正常、1 喜、2 眨眼、3 驚訝、4 害羞、5 怒
// 預設是小頭像：用 Jessy 另外畫的大頭 head.svg（只有一個表情，expr 不影響）；full 才顯示整張探頭構圖＋六個表情（首頁用）
import { url } from '../lib/url.js';
import { EXPRESSIONS } from '../lib/avatar.js';

interface Props {
  uid?: string;          // 舊介面保留，不再需要
  expr?: number;         // 初始表情
  size?: number;         // 寬度 px
  interactive?: boolean; // 點了會換表情
  cycle?: number[];      // 點擊時輪流的表情
  full?: boolean;        // 顯示整張（含身體）
  head?: boolean;        // 舊介面保留，預設就是只顯示頭
  class?: string;
}
const { expr = 0, size = 160, interactive = false, cycle = [0, 1, 2, 3, 4], full = false, class: cls = '' } = Astro.props;
const dir = 'avatar';

// 畫布座標（跟 build-avatar.py 的 VIEWBOX 一致）
const VB = { x: 27, y: 71, w: 500, h: 564 };
// 只顯示頭時的裁切範圍（正方形，含一點肩膀）
const HEAD = { x: 94, y: 84, s: 360 };

const h = full ? Math.round((size * VB.h) / VB.w) : size;
const scale = full ? size / VB.w : size / HEAD.s;
const imgStyle = full
  ? 'left:0;top:0;width:100%'
  : `left:${(-(HEAD.x - VB.x) * scale).toFixed(1)}px;top:${(-(HEAD.y - VB.y) * scale).toFixed(1)}px;width:${(VB.w * scale).toFixed(1)}px`;
const faces = EXPRESSIONS.slice(0, 6).map((name, i) => ({ i, name, src: url(`/${dir}/${i}.svg`) }));
const Tag = interactive ? 'button' : 'span';
---
<Tag
  class:list={['avatar', { 'is-interactive': interactive, 'is-full': full }, cls]}
  style={`--size:${size}px; --h:${h}px`}
  data-expr={expr}
  {...(interactive ? { type: 'button', 'data-cycle': cycle.join(','), 'aria-label': '戳一下 Jessy' } : { role: 'img', 'aria-label': 'Jessy 的手繪頭像' })}
>
  <span class="frame">
    {full
      ? faces.map((f) => <img src={f.src} alt="" data-e={f.i} style={imgStyle} draggable="false" decoding="async" />)
      : <img class="head-img" src={url('/avatar/head.svg')} alt="" draggable="false" decoding="async" />}
  </span>
</Tag>

<style is:global>
  .avatar { display: inline-block; width: var(--size); height: var(--h, var(--size)); flex: none; line-height: 0; }
  .avatar .frame { position: relative; display: block; width: 100%; height: 100%; overflow: hidden; }
  .avatar.is-full .frame { overflow: visible; }
  .avatar img { position: absolute; max-width: none; height: auto; visibility: hidden; user-select: none; }
  .avatar[data-expr="0"] img[data-e="0"],
  .avatar[data-expr="1"] img[data-e="1"],
  .avatar[data-expr="2"] img[data-e="2"],
  .avatar[data-expr="3"] img[data-e="3"],
  .avatar[data-expr="4"] img[data-e="4"],
  .avatar[data-expr="5"] img[data-e="5"] { visibility: visible; }
  /* 小頭像：Jessy 另外畫的大頭（只有一個表情） */
  .avatar img.head-img { position: static; width: 100%; height: 100%; visibility: visible; }
  button.avatar { background: none; border: 0; padding: 0; cursor: pointer; }
  button.avatar:focus-visible { outline: 2px solid var(--accent); outline-offset: 4px; }
  .avatar.pop .frame { animation: avatar-pop .38s cubic-bezier(.3,1.6,.5,1); }
  @keyframes avatar-pop { 0% { transform: translateY(0) scale(1); } 40% { transform: translateY(-6%) scale(1.03); } 100% { transform: none; } }
  @media (prefers-reduced-motion: reduce) { .avatar.pop .frame { animation: none; } }
</style>

<script>
  // 點一下換表情
  document.querySelectorAll<HTMLButtonElement>('button.avatar.is-interactive').forEach((btn) => {
    const cycle = (btn.dataset.cycle || '0').split(',').map(Number);
    let i = Math.max(0, cycle.indexOf(Number(btn.dataset.expr)));
    btn.addEventListener('click', () => {
      i = (i + 1) % cycle.length;
      btn.dataset.expr = String(cycle[i]);
      btn.classList.remove('pop');
      void btn.offsetWidth;
      btn.classList.add('pop');
      btn.dispatchEvent(new CustomEvent('avatar:poke', { bubbles: true, detail: { expr: cycle[i] } }));
    });
  });
</script>
