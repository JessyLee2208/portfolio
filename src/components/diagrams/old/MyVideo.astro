---
// myVideo 會員中心改版的圖解：取代 Notion 簡報匯出的小圖（02/04/06/07/08.png），文字照原圖
import Board from '../Board.astro';
import { tr } from '../../../lib/en-dict.js';
const x = tr(Astro.url);
interface Props { kind: 'goals' | 'method' | 'survey' | 'ia' | 'usability' | 'competitors'; }
const { kind } = Astro.props;
---
{kind === 'competitors' && (() => {
  // 精簡對照表（11/10 Jessy 選）：產品橫向、面向直向，字縮短，有無用 ✓ ✕；★ 欄是本次主要參考（原圖框起來的三個）
  const P = [
    { n: 'Netflix', ref: true, v: [['✓', '4+1'], [x('全頁展開')], [x('等級月租')], ['✕']] },
    { n: 'Apple TV+', v: [['✓', '5+1'], [x('全頁展開')], [x('月租＋點數')], ['✕']] },
    { n: x('愛奇藝'), v: [['✕'], [x('側邊分頁')], [x('方案月租')], ['✕']] },
    { n: 'Spotify', ref: true, v: [['✓', '6'], [x('側邊分頁')], [x('方案月租')], ['✓']] },
    { n: 'Melon', ref: true, v: [['✕'], [x('綜合型')], [x('月租＋單曲＋點數')], ['✕']] },
    { n: 'KKBOX', v: [['✕'], [x('側邊分頁')], [x('方案月租')], ['✕']] },
  ];
  const K = [x('共享帳號'), x('資訊架構'), x('營收方式'), x('身分別內容')];
  return (
    <Board kicker="Competitive Analysis" title={x('競品分析')} c="myvideo" label={x('競品分析對照表：Netflix、Apple TV+、愛奇藝、Spotify、Melon、KKBOX 的共享帳號、資訊架構、營收方式、身分別內容變化')}>
      <div class="mx-wrap">
        <table class="mx">
          <thead><tr><th></th>{P.map((p) => <th class:list={{ ref: p.ref }}>{p.ref && <span class="star" aria-label={x('主要參考')}>★</span>}{p.n}</th>)}</tr></thead>
          <tbody>
            {K.map((k, r) => (
              <tr><th>{k}</th>{P.map((p) => {
                const [a, b] = p.v[r];
                const mark = a === '✓' ? 'yes' : a === '✕' ? 'no' : '';
                return <td class:list={[{ ref: p.ref }, mark]}>{a}{b && <small>{b}</small>}</td>;
              })}</tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="clegend"><span class="star">★</span> {x('本次主要參考的產品　·　共享帳號的數字是可同時使用的人數')}</p>
    </Board>
  );
})()}

{kind === 'goals' && (
  <Board kicker="Focus" title={x('聚焦目的')} c="myvideo" label={x('聚焦目的：提升用戶的決策效率、查找速度、使用感受')}>
    <ol class="goals">
      {[x('決策效率'), x('查找速度'), x('使用感受')].map((n) => (
        <li class="panel"><span class="kick">{x('提升用戶')}</span><span class="name">{n}</span></li>
      ))}
    </ol>
  </Board>
)}

{kind === 'method' && (
  <Board kicker="Research Method" title={x('研究執行方法')} c="myvideo" label={x('研究執行方法：資料收集、問卷調查、訪談與易用性測試')}>
    <ol class="steps">
      {[
        [x('資料收集'), x('了解他產品的資訊架構，相似的重點功能如何呈現？')],
        [x('問卷調查'), x('掌握現行用戶的使用行為、對於會員中心的需求以及期待。')],
        [x('訪談＆易用性測試'), x('使用改版後的 prototype 進行易用性測試，觀察用戶是否達成本次專案的目標，把握在不流失用戶的情形下新用戶也可以順利使用。')],
      ].map(([t, d], i) => (
        <li class="panel step"><span class="num">{i + 1}</span><span class="t">{t}</span><span class="d">{d}</span></li>
      ))}
    </ol>
  </Board>
)}

{kind === 'survey' && (
  <Board kicker="Survey" title={x('問卷發放對象')} c="myvideo" label={x('問卷發放對象：有 myVideo 會員資格、近一個月內有使用、觀看超過 10 分鐘；30～49 歲；App、Web')}>
    <dl class="panel survey">
      {[
        [x('對象'), x('有 myVideo 會員資格、近一個月內有使用 myVideo 服務、觀看分鐘數超過 10 分鐘以上')],
        [x('年齡'), x('30～49 歲區間')],
        [x('設備'), 'App、Web'],
      ].map(([k, v]) => (
        <div class="crit"><dt class="pill-k">{k}</dt><dd>{v}</dd></div>
      ))}
    </dl>
  </Board>
)}

{kind === 'ia' && (
  <Board kicker="Information Architecture" title={x('資訊架構重整單元劃分')} c="myvideo" label={x('會員中心框架重構：身份管理、資訊總覽、帳號設定、交易總覽四個單元')}>
    <div class="ia">
      <span class="node n-top">{x('資訊總覽')}</span>
      <span class="node n-left">{x('身份管理')}</span>
      <span class="hub">{x('會員中心')}<br />{x('框架重構')}</span>
      <span class="node n-right">{x('帳號設定')}</span>
      <span class="node n-bottom">{x('交易總覽')}</span>
    </div>
  </Board>
)}

{kind === 'usability' && (
  <Board kicker="Usability Test" title={x('易用性測試摘要')} c="myvideo" label={x('易用性測試：Task 一易用性評分 70；Task 二身份共享 A 版本 77、B 版本 52')}>
    <div class="ut">
      {[
        { n: x('一'), cnt: 11, t: x('帳戶總覽、交易總覽、帳號設定'), d: x('透過易用性測試，找出用戶會遇到困難或認知障礙的地方，並進行修改'), bars: [[x('評分'), 70, true]] },
        { n: x('二'), cnt: 3, t: x('身份共享 A/B 版本'), d: x('透過 A/B 兩種版本決定之後共享身分的流程走向，並觀察用戶的反應。'), bars: [[x('A 版本'), 77, true], [x('B 版本'), 52, false]] },
      ].map((k) => (
        <div class="panel task">
          <p class="tk">{x('測試 Task')} {k.n}<span>{k.cnt} {x('項測試')}</span></p>
          <p class="tt">{k.t}</p>
          <div class="bars">
            {k.bars.map(([lab, v, on]) => (
              <div class:list={['bar', { on }]}>
                <span class="bl">{lab}</span>
                <span class="track"><i style={`width:${v}%`}></i><em class="pass" aria-hidden="true"></em></span>
                <b>{v}</b>
              </div>
            ))}
          </div>
          <p class="td">{k.d}</p>
        </div>
      ))}
    </div>
    <p class="passnote"><em class="pass-key"></em>{x('虛線是及格分數：易用性的平均分數為 68 分，因此可以將此分數作為產品及格分數')}</p>
  </Board>
)}

<style>
  /* 聚焦目的（同分店頁） */
  .goals { list-style: none; padding: 0; margin: 0 auto; max-width: 860px; display: grid; gap: 16px; }
  @media (min-width: 640px) { .goals { grid-template-columns: repeat(3, 1fr); } }
  .goals .panel { display: grid; justify-items: center; text-align: center; padding: 26px 16px; }
  .kick { color: var(--tone-ink); font-weight: 700; font-size: 14px; letter-spacing: .04em; }
  .name { margin-top: 4px; font-size: clamp(26px, 3.2vw, 34px); font-weight: 900; line-height: 1.2; }

  /* 三步流程 */
  .steps { list-style: none; padding: 0; margin: 0 auto; max-width: 900px; display: grid; gap: 14px; counter-reset: s; }
  @media (min-width: 760px) { .steps { grid-template-columns: repeat(3, 1fr); } }
  .step { display: grid; gap: 8px; align-content: start; }
  .num { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--tone-ink); color: #fff; font: 700 13px/1 var(--f-mono); }
  .step .t { font-size: 20px; font-weight: 900; }
  .step .d { font-size: 14.5px; line-height: 1.7; color: var(--muted); }

  /* 問卷對象：一張卡、三列，標籤在左、內容在右（11/10 Jessy：內容少不要佔太大） */
  .survey { max-width: 640px; margin: 0 auto; display: grid; gap: 10px; padding: 18px 20px; }
  .crit { display: grid; grid-template-columns: auto 1fr; gap: 12px; align-items: baseline; }
  .crit + .crit { border-top: 1px dashed var(--line); padding-top: 10px; }
  .pill-k { background: var(--tone-ink); color: #fff; font-weight: 700; font-size: 13px; padding: 3px 10px; border-radius: 6px; }
  .crit dd { margin: 0; font-size: 15px; line-height: 1.7; }

  /* 資訊架構：中心＋四方 */
  .ia { display: grid; grid-template-columns: 1fr auto 1fr; grid-template-rows: auto auto auto; gap: 18px 14px; align-items: center; justify-items: center; max-width: 620px; margin: 0 auto; position: relative; }
  .hub { grid-area: 2 / 2; background: var(--sheet); border: 2px solid var(--tone-ink); color: var(--tone-ink); font-weight: 900; font-size: clamp(16px, 2.4vw, 20px); padding: 14px 18px; border-radius: 14px; text-align: center; line-height: 1.4; box-shadow: var(--shadow); }
  .node { font-weight: 900; font-size: clamp(15px, 2vw, 18px); background: var(--paper); border: 1px solid var(--line); padding: 8px 14px; border-radius: 999px; position: relative; white-space: nowrap; }
  @media (max-width: 560px) { .node { white-space: normal; text-align: center; padding: 6px 10px; font-size: 13.5px; } .hub { padding: 10px 12px; } }
  .n-top { grid-area: 1 / 2; } .n-bottom { grid-area: 3 / 2; } .n-left { grid-area: 2 / 1; justify-self: end; } .n-right { grid-area: 2 / 3; justify-self: start; }
  .n-top::after, .n-bottom::before { content: ''; position: absolute; left: 50%; width: 0; height: 18px; border-left: 2px solid var(--tone-ink); opacity: .5; }
  .n-top::after { top: 100%; } .n-bottom::before { bottom: 100%; }
  .n-left::after, .n-right::before { content: ''; position: absolute; top: 50%; width: 14px; border-top: 2px solid var(--tone-ink); opacity: .5; }
  .n-left::after { left: 100%; } .n-right::before { right: 100%; }

  /* 易用性測試：兩個 Task 並排，分數用長條（滿分 100），虛線標出及格 68 分 */
  .ut { display: grid; gap: 14px; max-width: 860px; margin: 0 auto; }
  @media (min-width: 600px) { .ut { grid-template-columns: 1fr 1fr; } }
  .task { display: grid; gap: 8px; align-content: start; padding: 16px 18px; }
  .tk { margin: 0; font: 700 13px/1 var(--f-mono); color: var(--muted); display: flex; justify-content: space-between; }
  .tk span { font-weight: 500; }
  .tt { margin: 0; font-weight: 900; font-size: 17px; line-height: 1.4; color: var(--tone-ink); }
  .bars { display: grid; gap: 8px; margin: 4px 0; }
  .bar { display: grid; grid-template-columns: 5em 1fr 2.2em; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .bar b { font: 800 22px/1 var(--f-display); color: var(--muted); text-align: right; }
  .bar.on b { color: var(--tone-ink); }
  .track { position: relative; height: 12px; border-radius: 99px; background: var(--paper); border: 1px solid var(--line); overflow: visible; }
  .track i { display: block; height: 100%; border-radius: 99px; background: #cfc8bd; }
  .bar.on .track i { background: var(--tone-ink); }
  .pass { position: absolute; left: 68%; top: -4px; bottom: -4px; border-left: 2px dashed var(--ink); opacity: .5; }
  .td { margin: 0; font-size: 13.5px; line-height: 1.6; color: var(--muted); }
  .passnote { margin: 12px 0 0; text-align: center; font-size: 13px; color: var(--muted); }
  .pass-key { display: inline-block; width: 0; height: 12px; border-left: 2px dashed var(--ink); opacity: .5; margin-right: 6px; vertical-align: -1px; }

  /* 競品分析：精簡對照表 */
  .mx-wrap { overflow-x: auto; max-width: 900px; margin: 0 auto; border-radius: 14px; background: var(--sheet); box-shadow: var(--shadow); border: 1px solid var(--line); }
  /* .mx-wrap .mx：權重要蓋過案例頁內文表格的樣式（.prose table） */
  .mx-wrap .mx { width: 100%; min-width: 600px; margin: 0; border-collapse: collapse; font-size: 14px; text-align: center; table-layout: fixed; background: none; box-shadow: none; border-radius: 0; }
  .mx-wrap .mx th { background: none; text-align: center; }
  .mx th, .mx td { padding: 12px 6px; border-bottom: 1px solid var(--line); vertical-align: middle; line-height: 1.35; }
  .mx tr:last-child th, .mx tr:last-child td { border-bottom: 0; }
  .mx thead th { font-weight: 900; font-size: 14px; }
  .mx-wrap .mx tbody th { text-align: left; padding-left: 14px; font-weight: 700; color: var(--muted); position: sticky; left: 0; background: var(--sheet); white-space: nowrap; }
  .mx-wrap .mx thead th:first-child { width: 8em; position: sticky; left: 0; background: var(--sheet); }
  .mx-wrap .mx .ref { background: color-mix(in srgb, var(--tone) 12%, var(--sheet)); }
  .mx thead .ref { color: var(--tone-ink); }
  .mx td { font-weight: 600; }
  .mx td.yes { color: var(--tone-ink); font-size: 18px; font-weight: 900; }
  .mx td.no { color: #c9c2b8; font-size: 16px; }
  .mx small { display: block; font-size: 12px; font-weight: 600; color: var(--muted); }
  .star { color: var(--tone-ink); margin-right: 3px; }
  .clegend { margin: 12px 0 0; text-align: center; font-size: 13px; color: var(--muted); }
</style>
