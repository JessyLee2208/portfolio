---
// BookFast 分鐘計費卡的圖解與畫面：規則照 Figma spec（計時計次 2hMBdMAHdX2G5NHW48bQMy），畫面從 spec 複製到「做圖區」後匯出（11/10）
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Board from '../Board.astro';
import Plate from '../../Plate.astro';
import '../../../styles/diagram.css';
import adminList from '../../../assets/cases/timecard/admin-list.png';
import adminRate from '../../../assets/cases/timecard/admin-rate.png';
import adminTopup from '../../../assets/cases/timecard/admin-topup.png';
import adminEntry from '../../../assets/cases/timecard/admin-entry.png';
import appMine from '../../../assets/cases/timecard/app-mine.png';
import appPlan from '../../../assets/cases/timecard/app-plan.png';
import appExpired from '../../../assets/cases/timecard/app-expired.png';
import appQr from '../../../assets/cases/timecard/app-qr.png';
import appScan from '../../../assets/cases/timecard/app-scan.png';
import rOk from '../../../assets/cases/timecard/refund-ok.png';
import rNo from '../../../assets/cases/timecard/refund-no.png';
import rDone from '../../../assets/cases/timecard/refund-done.png';
import rInv from '../../../assets/cases/timecard/refund-done-invoice.png';
import homeTimer from '../../../assets/cases/timecard/app-home-timer.png';
import timerSheet from '../../../assets/cases/timecard/app-timer.png';
import newBase from '../../../assets/cases/timecard/admin-new-base.png';
import newForm from '../../../assets/cases/timecard/admin-new-form.png';
interface Props { kind: 'hero' | 'deduct' | 'refund' | 'settle' | 'app' | 'scan' | 'new-plan' | 'roles' | 'lanes' | 'timer' | 'journey' | 'features'; }
const { kind } = Astro.props;
const phone = (img: ImageMetadata, cap: string) => ({ img, cap });
// 會員旅程：11/10 Jessy 嫌原版色塊太多太雜，選了 A 表格版（只用黑灰字，靠粗細分層）
const JR = [
  { st: '購買', do: '在官網、App 或櫃檯買點數方案', think: '每分鐘多少錢？買多少才夠？', pain: '不知道計費方式，很難判斷要買哪個方案', fix: '購買頁列出點數、會館、啟用方式和期限' },
  { st: '進場', do: '掃 QR code 進場', think: '這張卡能用嗎？還有欠款嗎？', pain: '手上有好幾張卡，不知道會用哪張', fix: '顯示這張卡的點數；有欠款時卡片壓上欠款圖和餘額，補完才能進場' },
  { st: '在館內', do: '運動中', think: '我待多久了？會扣多少？', pain: '計費看不見，擔心超時多扣', fix: '首頁計時器顯示已待多久、預計扣幾點' },
  { st: '出場', do: '掃 QR code 出場', think: '扣了多少？還剩多少？', pain: '點數不夠怎麼辦？扣的是哪一筆？', fix: '自動選進場那張卡、照扣點順序扣；點數不夠也能出場，差額變成欠款' },
  { st: '之後', do: '查紀錄、加值或退款', think: '點數快過期了嗎？還能退嗎？', pain: '規則複雜，不知道能退多少', fix: '「我的」看總點數和各方案，用完的收進失效方案' },
];

---
{kind === 'hero' && (
  <!-- 開場圖：場館端／會員端兩個分頁，場館端用瀏覽器視窗、會員端用手機框，都能左右滑（11/10 Jessy） -->
  <figure class="tc-hero2 reveal" aria-label="分鐘計費卡的場館端後台與會員端 App 畫面">
    <div class="sw" role="tablist" aria-label="切換畫面">
      <button type="button" role="tab" id="tab-b" aria-controls="pan-b" aria-selected="true" class="on">場館端<small>後台 Web</small></button>
      <button type="button" role="tab" id="tab-c" aria-controls="pan-c" aria-selected="false" tabindex="-1">會員端<small>App</small></button>
    </div>
    <div class="fc" data-fc id="pan-b" role="tabpanel" aria-labelledby="tab-b">
      <div class="fc-nav">
        <button type="button" class="fc-btn" data-dir="-1" aria-label="上一張"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></button>
        <button type="button" class="fc-btn" data-dir="1" aria-label="下一張"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
      </div>
      <ul class="fc-row desk-row" tabindex="0" aria-label="場館端畫面，可以左右滑動">
        {[[adminList, '方案列表'], [adminRate, '費用設定'], [newBase, '新增方案'], [adminTopup, '櫃檯現場加值'], [adminEntry, '手動登記進出場']].map(([img, cap]) => (
          <li class="desk-card">
            <div class="win"><div class="bar" aria-hidden="true"><i></i><i></i><i></i></div><Image src={img as ImageMetadata} alt={cap as string} widths={[700, 1100]} sizes="(min-width: 900px) 560px, 80vw" /></div>
            <p class="cap">{cap}</p>
          </li>
        ))}
      </ul>
    </div>
    <div class="fc" data-fc id="pan-c" role="tabpanel" aria-labelledby="tab-c" hidden>
      <div class="fc-nav">
        <button type="button" class="fc-btn" data-dir="-1" aria-label="上一張"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></button>
        <button type="button" class="fc-btn" data-dir="1" aria-label="下一張"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
      </div>
      <ul class="fc-row phone-row" tabindex="0" aria-label="會員端畫面，可以左右滑動">
        {[[appMine, '我的通行卡'], [homeTimer, '館內計時器'], [timerSheet, '預計扣點'], [appQr, 'QR code 進出場'], [appPlan, '方案明細'], [appExpired, '失效方案']].map(([img, cap]) => (
          <li class="ph-card">
            <div class="frame"><Image src={img as ImageMetadata} alt={cap as string} widths={[300, 600]} sizes="200px" /></div>
            <p class="cap">{cap}</p>
          </li>
        ))}
      </ul>
    </div>
  </figure>
)}

{kind === 'roles' && (
  <Board plate title="四個角色，各自在意的事" c="timecard" label="會員、場館老闆、櫃檯人員、BookFast 對分鐘計費各自在意的事，以及對應到的設計重點">
    <div class="roles">
      {[
        ['會員', ['計費方式要清楚：每分鐘幾點、怎麼算', '在場館裡也能知道自己實際待了多久', '還剩多少點，點數不要過期浪費'], ['扣點順序', '會員端']],
        ['場館老闆', ['知道怎麼建立方案才是正確的方案', '計費方式有沒有設對', '錢什麼時候拿得到，對帳要清楚'], ['後台設定', '核銷']],
        ['櫃檯人員', ['可以在櫃檯快速幫會員加值', '可以手動登記進出場', '退款時照畫面走就不會退錯'], ['現場加值', '進場登記', '註銷流程']],
        ['BookFast', ['會員付的錢先由 BookFast 保管，撥給店家要有依據', '退款和爭議的風險要控制住'], ['退款規則', '核銷']],
      ].map(([who, needs, map]) => (
        <div class="panel role">
          <span class="rt">{who}</span>
          <ul>{(needs as string[]).map((n) => <li>{n}</li>)}</ul>
          <span class="map">{(map as string[]).map((m) => <i>{m}</i>)}</span>
        </div>
      ))}
    </div>
  </Board>
)}

{kind === 'journey' && (
  <Board plate title="會員旅程：從買卡到出場" c="timecard" label="會員旅程：購買、進場、在館內、出場、之後五個階段，會員在做什麼、心裡在想什麼、痛點，以及對應的解法">
    <!-- 桌機用表格（A），手機一步一列（B），11/10 Jessy -->
    <div class="ja-wrap">
      <table class="ja">
        <thead><tr><th></th>{JR.map((r, i) => <th><span class="n">{i + 1}</span>{r.st}</th>)}</tr></thead>
        <tbody>
          <tr><th>做什麼</th>{JR.map((r) => <td class="d">{r.do}</td>)}</tr>
          <tr><th>心裡想</th>{JR.map((r) => <td class="t">「{r.think}」</td>)}</tr>
          <tr><th>痛點</th>{JR.map((r) => <td class="p">{r.pain}</td>)}</tr>
          <tr><th>解法</th>{JR.map((r) => <td class="f">{r.fix}</td>)}</tr>
        </tbody>
      </table>
    </div>
    <ol class="jb">
      {JR.map((r, i) => (
        <li>
          <p class="jb-st"><span class="n">{i + 1}</span><b>{r.st}</b></p>
          <dl class="jb-dl">
            <dt>做什麼</dt><dd>{r.do}</dd>
            <dt>心裡想</dt><dd class="t">「{r.think}」</dd>
            <dt>痛點</dt><dd>{r.pain}</dd>
            <dt>解法</dt><dd class="f">{r.fix}</dd>
          </dl>
        </li>
      ))}
    </ol>
  </Board>
)}

{kind === 'features' && (
  <Plate label="會員 App：主要功能（可以左右滑）" card={false} alt="會員 App 的七個功能：我的通行卡、方案明細、失效方案、館內計時器、預計扣點、出示 QR code、相機掃描">
    <!-- 橫向滑的功能卡：參考 rebecca-yang.com（11/10 Jessy），一個功能一張卡；電腦版右上角有左右按鈕 -->
    <div class="fc" data-fc>
      <div class="fc-nav">
        <button type="button" class="fc-btn" data-dir="-1" aria-label="上一張"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7" /></svg></button>
        <button type="button" class="fc-btn" data-dir="1" aria-label="下一張"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7" /></svg></button>
      </div>
      <ul class="fc-row" tabindex="0" aria-label="功能卡，可以左右滑動">
        {[
          [appMine, '我的通行卡', '一打開就看到總點數，不用自己加總'],
          [appPlan, '方案明細', '每個方案的期間、額度、已用多少'],
          [appExpired, '失效方案', '用完、過期的收起來，不跟可用的混在一起'],
          [homeTimer, '館內計時器', '首頁右下角顯示已經待了多久'],
          [timerSheet, '預計扣點', '點開計時器，看到餘額和這次預計扣幾點'],
          [appQr, '出示 QR code', '拿給場館的掃描器掃，進出場用同一張'],
          [appScan, '相機掃描', '用手機相機掃場館的 QR code 進出場'],
        ].map(([img, t, d]) => (
          <li class="fc-card">
            <div class="frame"><Image src={img as ImageMetadata} alt="" widths={[300, 600]} sizes="200px" /></div>
            <p class="fc-t">{t}</p>
            <p class="fc-d">{d}</p>
          </li>
        ))}
      </ul>
    </div>
  </Plate>
)}

{kind === 'lanes' && (
  <Board plate title="一張卡從開賣到核銷，各方做什麼" c="timecard" label="泳道圖：會員、櫃檯人員、場館老闆、BookFast 在開賣前、販售、進出場、註銷退款、核銷五個階段各自做的事">
    <div class="lanes-wrap" tabindex="0" aria-label="泳道圖，可以左右滑動">
      <div class="lanes">
        <span class="corner"></span>
        {['開賣前', '販售', '進出場', '註銷退款', '核銷'].map((st, i) => <span class="st"><b>{i + 1}</b>{st}</span>)}
        {[
          ['會員', ['', '在品牌官網、App 購買方案', '掃 QR code 進出場；App 上看已經待多久、預計扣幾點', '向場館提出退款', '']],
          ['櫃檯人員', ['', '在櫃檯幫會員現場加值', '手動幫會員登記進出場', '在後台註銷，照畫面選退款方式與發票處理', '']],
          ['場館老闆', ['設定每分鐘收費、緩衝時間，建立方案', '方案上架，設定販售渠道與數量', '', '', '從報表對帳，收到撥款']],
          ['BookFast', ['', '代收會員付的錢（信用卡、樂享券）', '依停留時間和扣點順序扣點', '判斷能不能退、退多少，線上刷退', '依使用狀況核銷撥款給店家，零頭進位']],
        ].map(([who, cells]) => (
          <>
            <span class="who-l">{who}</span>
            {(cells as string[]).map((c) => c ? <span class="cell">{c}</span> : <span class="cell empty" aria-hidden="true"></span>)}
          </>
        ))}
      </div>
    </div>
  </Board>
)}

{kind === 'deduct' && (
  <Board plate title="扣點順序：三條規則依序判斷" c="timecard" label="扣點順序：一、最先到期的方案；二、到期日相同時，已經用過的先扣；三、點數先扣，贈點最後。例子：會員有四筆額度，扣點順序是 B 方案點數、C 方案點數、B 方案贈點、A 方案點數">
    <ol class="rules">
      {[['最先到期的先扣', '到期日越近，越先用掉'], ['用過的先扣', '到期日一樣時，額度不完整的先扣'], ['點數先扣，贈點最後', '會員花錢買的點數，比送的贈點先用']].map(([t, d], i) => (
        <li class="panel rule"><span class="num">{i + 1}</span><span class="t">{t}</span><span class="d">{d}</span></li>
      ))}
    </ol>
    <div class="panel ex">
      <p class="ex-t">例子：會員的卡裡有 4 筆額度，這次進場要扣 50 點</p>
      <table class="ex-tb">
        <thead><tr><th>順序</th><th>額度</th><th>到期日</th><th>剩餘</th><th>為什麼排這裡</th></tr></thead>
        <tbody>
          <tr><td><b class="o">1</b></td><td>B 方案・點數</td><td>2023/01/31</td><td>45 / 100</td><td>最早到期，而且已經用過</td></tr>
          <tr><td><b class="o">2</b></td><td>C 方案・點數</td><td>2023/01/31</td><td>100 / 100</td><td>同一天到期，但還沒用過</td></tr>
          <tr><td><b class="o">3</b></td><td>B 方案・贈點</td><td>2023/01/31</td><td>20 / 20</td><td>同一天到期，贈點排在點數後面</td></tr>
          <tr class="dim"><td><b class="o">4</b></td><td>A 方案・點數</td><td>2023/03/31</td><td>120 / 120</td><td>最晚到期，最後才扣</td></tr>
        </tbody>
      </table>
      <p class="ex-r">這次扣 50 點：B 方案點數扣完 45 點，剩下 5 點從 C 方案扣。</p>
    </div>
  </Board>
)}

{kind === 'refund' && (
  <Board plate title="退款規則：信用卡（聯邦）vs 樂享券" c="timecard" label="退款規則：聯邦信用卡只能單筆全額退款，而且額度要完整；樂享券可以退剩餘額度。兩種都要在付款日 60 天內、方案到期日 10 天內">
    <div class="cmp">
      <div class="panel col">
        <span class="ct">信用卡（聯邦）</span>
        <span class="lab">可以退多少</span><span class="v">單筆全額</span>
        <span class="lab">條件</span><span class="v">額度完整：一點都還沒用過</span>
      </div>
      <div class="panel col">
        <span class="ct">樂享券</span>
        <span class="lab">可以退多少</span><span class="v">剩餘額度</span>
        <span class="lab">條件</span><span class="v">用過也能退，退還沒用完的部分</span>
      </div>
    </div>
    <p class="both"><b>兩種都一樣</b>付款日 +60 天內，而且在方案到期日 +10 天內</p>
  </Board>
)}

{kind === 'settle' && (
  <Board plate title="零頭的處理：整數退會員，零頭進位給店家" c="timecard" label="核銷規則：樂享券註銷時剩 10.4 點，退 10 點給會員；0.4 點無條件進位成 1 點，走點數核銷給店家">
    <div class="split">
      <div class="panel src"><span class="lab">註銷時剩下</span><span class="big">10.4<small>點</small></span></div>
      <svg class="arr" viewBox="0 0 60 120" aria-hidden="true"><path d="M4 60 C 24 60, 30 22, 54 22 M4 60 C 24 60, 30 98, 54 98 M46 16 L55 22 L46 28 M46 92 L55 98 L46 104" /></svg>
      <div class="outs">
        <div class="panel out"><span class="lab">整數退給會員</span><span class="big">10<small>點</small></span></div>
        <div class="panel out shop"><span class="lab">零頭進位，核銷給店家</span><span class="big">1<small>點</small></span><span class="note2">註銷日視為點數使用日，+14 天核銷</span></div>
      </div>
    </div>
    <div class="pcons">
      <div class="panel"><span class="lab">好處</span>最後一筆就算沒有全部用完，店家也拿得到錢，風險控制在幾十元內</div>
      <div class="panel"><span class="lab">風險</span>會員發現少退了零頭，可能跟店家起爭議</div>
      <div class="panel"><span class="lab">配套</span>販售條款註明遇到非整數無條件捨去；真的有爭議，由店家自行退款給會員</div>
    </div>
  </Board>
)}

{kind === 'new-plan' && (
  <div class="np-shot">
    <Image src={newBase} alt="後台新增計時方案：左邊是方案明細，右邊是方案與販售設定" widths={[800, 1426]} sizes="(max-width: 760px) 100vw, 680px" />
    <!-- 右邊表單疊在底圖上，只有這一塊能捲動，跟實際的彈窗一樣（11/10 Jessy） -->
    <div class="np-scroll" tabindex="0" aria-label="新增方案的設定表單，可以上下捲動看完整內容">
      <Image src={newForm} alt="" widths={[600, 1192]} sizes="(max-width: 760px) 42vw, 290px" />
    </div>
    <span class="np-hint" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v16M7 9l5-5 5 5M7 15l5 5 5-5" /></svg>在表單上滑動</span>
  </div>
)}

{kind === 'app' && (
  <Plate label="會員 App：我的通行卡" card={false} alt="會員 App：我的通行卡、通行卡方案、失效方案">
    <div class="phones">
      {[phone(appMine, '我的：一眼看到總點數'), phone(appPlan, '方案明細：額度與期間'), phone(appExpired, '失效方案：用完的收起來')].map(({ img, cap }, i) => (
        <figure class={`ph p${i}`}>
          <div class="frame"><Image src={img} alt="" widths={[300, 600]} sizes="(min-width: 760px) 200px, 30vw" /></div>
          <figcaption>{cap}</figcaption>
        </figure>
      ))}
    </div>
  </Plate>
)}

{kind === 'timer' && (
  <Plate label="會員 App：在館內也知道待了多久" card={false} alt="App 首頁的計時器：顯示已經待了多久；點開顯示進場時間、餘額與預計扣點">
    <div class="phones">
      {[phone(homeTimer, '首頁右下：已經待了多久'), phone(timerSheet, '點開：餘額與預計扣點')].map(({ img, cap }, i) => (
        <figure class={`ph p${i}`}>
          <div class="frame"><Image src={img} alt="" widths={[300, 600]} sizes="(min-width: 760px) 200px, 30vw" /></div>
          <figcaption>{cap}</figcaption>
        </figure>
      ))}
    </div>
  </Plate>
)}

{kind === 'scan' && (
  <Plate label="會員 App：兩種進出場方式" card={false} alt="App 進出場：出示 QR code 給掃描器，或用相機掃場館的 QR code">
    <div class="phones">
      {[phone(appQr, '出示 QR code 給掃描器'), phone(appScan, '用相機掃場館的 QR code')].map(({ img, cap }, i) => (
        <figure class={`ph p${i}`}>
          <div class="frame"><Image src={img} alt="" widths={[300, 600]} sizes="(min-width: 760px) 200px, 30vw" /></div>
          <figcaption>{cap}</figcaption>
        </figure>
      ))}
    </div>
  </Plate>
)}

