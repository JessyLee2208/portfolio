<script>
  // 功能卡的左右按鈕：一次捲一張卡的寬度，到頭或到尾時按鈕變淡
  document.querySelectorAll('[data-fc]').forEach((fc) => {
    const row = fc.querySelector('.fc-row');
    const btns = fc.querySelectorAll('.fc-btn');
    const step = () => (row.querySelector('.fc-card')?.getBoundingClientRect().width ?? 200) + 14;
    const sync = () => {
      btns[0].disabled = row.scrollLeft < 4;
      btns[1].disabled = row.scrollLeft + row.clientWidth > row.scrollWidth - 4;
    };
    btns.forEach((b) => b.addEventListener('click', () => row.scrollBy({ left: step() * Number(b.dataset.dir), behavior: 'smooth' })));
    row.addEventListener('scroll', sync, { passive: true });
    sync();
    new ResizeObserver(sync).observe(row);
  });
  // 開場的場館端／會員端分頁
  document.querySelectorAll('.tc-hero2').forEach((h) => {
    const tabs = [...h.querySelectorAll('[role=tab]')];
    const pick = (t) => tabs.forEach((x) => {
      const on = x === t;
      x.classList.toggle('on', on); x.setAttribute('aria-selected', String(on)); x.tabIndex = on ? 0 : -1;
      h.querySelector('#' + x.getAttribute('aria-controls')).hidden = !on;
    });
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => pick(t));
      t.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        const n = tabs[(i + (e.key === 'ArrowRight' ? 1 : tabs.length - 1)) % tabs.length];
        pick(n); n.focus();
      });
    });
  });
</script>
