---
// myVideo 的畫面圖解：把 Notion 的簡報圖（01.gif、03/05/09/10/11.png）拆成單張畫面，用網站風格重排
// 畫面截自 Notion 原圖；說明文字照原圖
import { Image } from 'astro:assets';
import Board from '../Board.astro';
import '../../../styles/diagram.css';
import oldAnnot from '../../../assets/cases/myvideo/old-annot.png';
import pb1 from '../../../assets/cases/myvideo/plans-b1.png';
import pb2 from '../../../assets/cases/myvideo/plans-b2.png';
import pb3 from '../../../assets/cases/myvideo/plans-b3.png';
import pa1 from '../../../assets/cases/myvideo/plans-a1.png';
import pa2 from '../../../assets/cases/myvideo/plans-a2.png';
import pa3 from '../../../assets/cases/myvideo/plans-a3.png';
import ab1 from '../../../assets/cases/myvideo/acct-b1.png';
import ab2 from '../../../assets/cases/myvideo/acct-b2.png';
import aa1 from '../../../assets/cases/myvideo/acct-a1.png';
import aa2 from '../../../assets/cases/myvideo/acct-a2.png';
import fb1 from '../../../assets/cases/myvideo/fam-b1.png';
import fb2 from '../../../assets/cases/myvideo/fam-b2.png';
import fa1 from '../../../assets/cases/myvideo/fam-a1.png';
interface Props { kind: 'hero' | 'old' | 'plans' | 'account' | 'family'; }
const { kind } = Astro.props;
const sz = '(min-width: 1080px) 420px, (min-width: 760px) 44vw, 90vw';
const pairs = {
  plans: { title: '方案與交易紀錄', before: [[pb1, '我的帳戶'], [pb2, '點數查詢'], [pb3, '交易紀錄']], after: [[pa1, '我的訂閱方案'], [pa2, '租借購買紀錄'], [pa3, 'myVideo 錢錢']] },
  account: { title: '帳戶資訊', before: [[ab1, '個人資訊與方案'], [ab2, '付款設定']], after: [[aa1, '帳號資訊'], [aa2, '設定']] },
  family: { title: '家人共享', before: [[fb1, '選擇身份'], [fb2, '編輯身份（獨立頁面）']], after: [[fa1, '家人共享：所有身份同時攤開']] },
} as const;
---
{kind === 'hero' && (
  <figure class="dg case-branch reveal mv-hero" aria-label="myVideo 會員中心改版：舊版的帳戶頁，改成交易紀錄、帳號設定、家人共享三個單元">
    <div class="dg-pat" aria-hidden="true"></div>
    <div class="dg-body hero-row">
      <div class="col">
        <span class="tag">Before</span>
        <div class="shot dim"><Image src={pb1} alt="" widths={[600]} sizes="300px" /></div>
      </div>
      <svg class="arrow-svg arr" viewBox="0 0 80 60" aria-hidden="true"><path d="M6 40 C 24 6, 56 6, 70 36 M60 30 L71 38 L74 25" /></svg>
      <div class="col">
        <span class="tag on">After</span>
        <div class="after-stack">
          <div class="shot s1"><Image src={pa1} alt="" widths={[800]} sizes="420px" /></div>
          <div class="shot s2"><Image src={fa1} alt="" widths={[800]} sizes="420px" /></div>
        </div>
      </div>
    </div>
    <p class="hero-cap">會員中心框架重構：交易紀錄、帳號設定、家人共享</p>
  </figure>
)}

{kind === 'old' && (
  <Board kicker="Before" title="改版前的會員中心" c="branch" label="改版前的會員中心：資訊架構鬆散、方案明細不夠詳細、優惠區域不夠明顯">
    <div class="shot wide"><Image src={oldAnnot} alt="改版前的會員中心帳戶頁" widths={[800, 1200]} sizes="(min-width: 1080px) 860px, 92vw" /></div>
    <ol class="issues">
      <li><b>1</b>資訊架構鬆散，需要花時間找到相應的資訊位置</li>
      <li><b>2</b>方案明細不夠詳細，缺少用戶想要知道的必要信息</li>
      <li><b>3</b>優惠區域不夠明顯，用戶無法辨識相應的優惠資訊</li>
    </ol>
  </Board>
)}

{(kind === 'plans' || kind === 'account' || kind === 'family') && (() => {
  const p = pairs[kind];
  return (
    <Board kicker="Before → After" title={p.title} c="branch" label={`${p.title}改版前後`}>
      <div class="ba2">
        <div class="side">
          <span class="tag">Before</span>
          {p.before.map(([img, cap]) => (
            <figure class="item"><div class="shot dim"><Image src={img as ImageMetadata} alt={`改版前：${cap}`} widths={[600, 900]} sizes={sz} /></div><figcaption>{cap}</figcaption></figure>
          ))}
        </div>
        <div class="side">
          <span class="tag on">After</span>
          {p.after.map(([img, cap]) => (
            <figure class="item"><div class="shot"><Image src={img as ImageMetadata} alt={`改版後：${cap}`} widths={[600, 900, 1200]} sizes={sz} /></div><figcaption>{cap}</figcaption></figure>
          ))}
        </div>
      </div>
    </Board>
  );
})()}

<style>
  .tag { justify-self: center; display: inline-block; font: 600 12px/1 var(--f-mono); letter-spacing: .06em; color: var(--muted); background: var(--sheet); border: 1px solid var(--line); padding: 6px 10px; border-radius: 99px; }
  .tag.on { color: #fff; background: var(--tone-ink); border-color: var(--tone-ink); }
  .shot { border-radius: 10px; overflow: hidden; background: #222; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .shot :global(img) { display: block; width: 100%; height: auto; }
  .shot.dim :global(img) { filter: grayscale(.5) brightness(.95); }

  /* 頂部 */
  .mv-hero { margin: 40px 0 0; }
  .hero-row { display: grid; gap: 18px; align-items: center; max-width: 980px; margin: 0 auto; }
  @media (min-width: 760px) { .hero-row { grid-template-columns: 1fr 64px 1.5fr; } }
  .col { display: grid; gap: 12px; justify-items: center; }
  .col > .shot { width: 100%; max-width: 300px; }
  .after-stack { position: relative; width: 100%; max-width: 460px; padding-bottom: 18%; }
  .after-stack .s1 { width: 86%; }
  .after-stack .s2 { position: absolute; width: 70%; right: 0; bottom: 0; transform: rotate(2deg); }
  .arr { width: 56px; height: 42px; justify-self: center; }
  @media (max-width: 759px) { .arr { transform: rotate(90deg); } }
  :global(.dg) p.hero-cap { position: relative; text-align: center; font-weight: 900; font-size: clamp(18px, 2.2vw, 22px); margin: 22px 0 0; }

  /* 改版前問題 */
  .shot.wide { max-width: 860px; margin: 0 auto; }
  .issues { list-style: none; padding: 0; margin: 18px auto 0; max-width: 860px; display: grid; gap: 12px; }
  @media (min-width: 760px) { .issues { grid-template-columns: repeat(3, 1fr); } }
  .issues li { background: var(--sheet); border: 2px solid var(--tone-ink); border-radius: 12px; padding: 10px 14px; font-size: 14px; font-weight: 600; line-height: 1.6; box-shadow: 3px 3px 0 color-mix(in srgb, var(--tone-ink) 25%, transparent); }
  .issues b { display: inline-grid; place-items: center; width: 20px; height: 20px; margin-right: 6px; border-radius: 50%; background: var(--tone-ink); color: #fff; font: 700 12px/1 var(--f-mono); vertical-align: 1px; }

  /* 改版前後：左右兩欄 */
  .ba2 { display: grid; gap: 22px; max-width: 980px; margin: 0 auto; }
  @media (min-width: 760px) { .ba2 { grid-template-columns: 1fr 1.25fr; align-items: start; } }
  .side { display: grid; gap: 14px; }
  .item { margin: 0; display: grid; gap: 6px; }
  .item figcaption { font-size: 13px; color: var(--muted); text-align: center; }
</style>
