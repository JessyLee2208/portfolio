---
// myVideo 的畫面圖解：把 Notion 的簡報圖（01.gif、03/05/09/10/11.png）拆成單張畫面，用網站風格重排
// 畫面截自 Notion 原圖；說明文字照原圖
import { Image } from 'astro:assets';
import Board from '../Board.astro';
import '../../../styles/diagram.css';
import oldAnnot from '../../../assets/cases/myvideo/old-annot.png';
import pb1 from '../../../assets/cases/myvideo/plans-b1.png';
import pa1 from '../../../assets/cases/myvideo/plans-a1.png';
import ab1 from '../../../assets/cases/myvideo/acct-b1.png';
import aa1 from '../../../assets/cases/myvideo/acct-a1.png';
import fb1 from '../../../assets/cases/myvideo/fam-b1.png';
import fa1 from '../../../assets/cases/myvideo/fam-a1.png';
import { tr } from '../../../lib/en-dict.js';
const x = tr(Astro.url);
interface Props { kind: 'hero' | 'old' | 'plans' | 'account' | 'family'; }
const { kind } = Astro.props;
const sz = '(min-width: 1080px) 420px, (min-width: 760px) 44vw, 90vw';
// 每段只放一組代表畫面，框出改了哪裡，旁邊一句話（照原文的 Before／After）；座標是圖片寬高的 %
const pairs = {
  plans: { title: x('方案與交易紀錄'),
    before: { img: pb1, cap: x('我的帳戶'), box: [21, 43, 70, 30], text: x('將方案與帳號資訊顯示在同一區域，交易紀錄為獨立選單') },
    after: { img: pa1, cap: x('交易紀錄'), box: [14, 21, 13, 25], text: x('獨立出交易紀錄的獨立單元，方便用戶針對交易進行查找') } },
  account: { title: x('帳戶資訊'),
    before: { img: ab1, cap: x('我的帳戶'), box: [19, 9, 41, 8], text: x('將個人資訊與方案放在同個分類，付款設定與密碼保護則為不同選單') },
    after: { img: aa1, cap: x('帳號設定'), box: [14, 21, 13, 21], text: x('將帳號設定獨立出來，方便使用者做帳號的相關設定') } },
  family: { title: x('家人共享'),
    before: { img: fb1, cap: x('選擇身份（獨立入口）'), box: [37, 17, 26, 36], text: x('會員中心沒有身份修改與編輯，入口獨立') },
    after: { img: fa1, cap: x('家人共享'), box: [10, 21, 84, 59], text: x('將身份編輯與新增功能合併至會員中心，所有身分同時攤開，選擇編輯身份時不必切頁') } },
} as const;
---
{kind === 'hero' && (
  <figure class="dg case-myvideo reveal mv-hero" aria-label={x('myVideo 會員中心改版：舊版的帳戶頁，改成交易紀錄、帳號設定、家人共享三個單元')}>
    <div class="dg-pat" aria-hidden="true"></div>
    <div class="dg-body hero-row">
      <div class="col">
        <span class="tag">Before</span>
        <div class="shot dim"><Image src={pb1} alt="" widths={[600]} sizes="300px" /></div>
      </div>
      <svg class="arrow-svg arr" viewBox="0 0 80 60" aria-hidden="true"><path d="M6 40 C 24 6, 56 6, 70 36 M60 30 L71 38 L74 25" /></svg>
      <div class="col">
        <span class="tag on">After</span>
        <div class="after-stack">
          <div class="shot s1"><Image src={pa1} alt="" widths={[800]} sizes="420px" /></div>
          <div class="shot s2"><Image src={fa1} alt="" widths={[800]} sizes="420px" /></div>
        </div>
      </div>
    </div>
    <p class="hero-cap">{x('會員中心框架重構：交易紀錄、帳號設定、家人共享')}</p>
  </figure>
)}

{kind === 'old' && (
  <Board kicker="Before" title={x('改版前的會員中心')} c="myvideo" label={x('改版前的會員中心：資訊架構鬆散、方案明細不夠詳細、優惠區域不夠明顯')}>
    <div class="shot wide marked">
      <Image src={oldAnnot} alt={x('改版前的會員中心帳戶頁')} widths={[800, 1200]} sizes="(min-width: 1080px) 860px, 92vw" />
      {[[1, 1, 11, 12, 13], [2, 14, 57, 85, 24], [3, 14, 85, 85, 14]].map(([n, x, y, w, h]) => (
        <span class="mk" style={`left:${x}%;top:${y}%;width:${w}%;height:${h}%`}><b>{n}</b></span>
      ))}
    </div>
    <ol class="issues">
      <li><b>1</b>{x('資訊架構鬆散，需要花時間找到相應的資訊位置')}</li>
      <li><b>2</b>{x('方案明細不夠詳細，缺少用戶想要知道的必要信息')}</li>
      <li><b>3</b>{x('優惠區域不夠明顯，用戶無法辨識相應的優惠資訊')}</li>
    </ol>
  </Board>
)}

{(kind === 'plans' || kind === 'account' || kind === 'family') && (() => {
  const p = pairs[kind];
  const side = (it: typeof p.before, after: boolean) => (
    <div class="pside">
      <span class:list={['tag', { on: after }]}>{after ? 'After' : 'Before'}</span>
      <div class:list={['pshot', { dim: !after }]}>
        <Image src={it.img} alt={`${after ? x('改版後') : x('改版前')}：${it.cap}`} widths={[600, 900]} sizes={sz} />
        <span class="hl" style={`left:${it.box[0]}%;top:${it.box[1]}%;width:${it.box[2]}%;height:${it.box[3]}%`}></span>
      </div>
      <p class:list={['pnote', { on: after }]}>{it.text}</p>
    </div>
  );
  return (
    <Board kicker="Before → After" title={p.title} c="myvideo" label={`${p.title}：${x('改版前')} ${p.before.text}；${x('改版後')} ${p.after.text}`}>
      <div class="pair">
        {side(p.before, false)}
        <svg class="arrow-svg parr" viewBox="0 0 80 60" aria-hidden="true"><path d="M6 40 C 24 6, 56 6, 70 36 M60 30 L71 38 L74 25" /></svg>
        {side(p.after, true)}
      </div>
    </Board>
  );
})()}

<style>
  .tag { justify-self: center; display: inline-block; font: 600 12px/1 var(--f-mono); letter-spacing: .06em; color: var(--muted); background: var(--sheet); border: 1px solid var(--line); padding: 6px 10px; border-radius: 99px; }
  .tag.on { color: #fff; background: var(--tone-ink); border-color: var(--tone-ink); }
  .shot { border-radius: 10px; overflow: hidden; background: #222; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .shot :global(img) { display: block; width: 100%; height: auto; }
  .shot.dim :global(img) { filter: grayscale(.5) brightness(.95); }

  /* 頂部 */
  .mv-hero { margin: 40px 0 0; }
  .hero-row { display: grid; gap: 18px; align-items: center; max-width: 980px; margin: 0 auto; }
  @media (min-width: 760px) { .hero-row { grid-template-columns: 1fr 64px 1.5fr; } }
  .col { display: grid; gap: 12px; justify-items: center; }
  .col > .shot { width: 100%; max-width: 300px; }
  .after-stack { position: relative; width: 100%; max-width: 460px; padding-bottom: 18%; }
  .after-stack .s1 { width: 86%; }
  .after-stack .s2 { position: absolute; width: 70%; right: 0; bottom: 0; transform: rotate(2deg); }
  .arr { width: 56px; height: 42px; justify-self: center; }
  @media (max-width: 759px) { .arr { transform: rotate(90deg); } }
  :global(.dg) p.hero-cap { position: relative; text-align: center; font-weight: 900; font-size: clamp(18px, 2.2vw, 22px); margin: 22px 0 0; }

  /* 改版前問題 */
  .shot.wide { max-width: 860px; margin: 0 auto; }
  /* 改版前截圖上的 1、2、3：框出問題位置，編號對到下面的問題卡 */
  .shot.marked { position: relative; }
  .mk { position: absolute; border: 2.5px solid var(--mustard); border-radius: 8px; }
  .mk b { position: absolute; right: -11px; top: -11px; width: 22px; height: 22px; border-radius: 50%; display: grid; place-items: center; background: var(--mustard); color: #2a211c; font: 700 12px/1 var(--f-mono); box-shadow: 0 0 0 2px #222; }
  .issues { list-style: none; padding: 0; margin: 18px auto 0; max-width: 860px; display: grid; gap: 12px; }
  @media (min-width: 760px) { .issues { grid-template-columns: repeat(3, 1fr); } }
  .issues li { background: var(--sheet); border: 2px solid var(--tone-ink); border-radius: 12px; padding: 10px 14px; font-size: 14px; font-weight: 600; line-height: 1.6; box-shadow: 3px 3px 0 color-mix(in srgb, var(--tone-ink) 25%, transparent); }
  .issues b { display: inline-grid; place-items: center; width: 20px; height: 20px; margin-right: 6px; border-radius: 50%; background: var(--mustard); color: #2a211c; font: 700 12px/1 var(--f-mono); vertical-align: 1px; }

  /* 改版前後：左右各一張，框出改動的地方，下面一句話 */
  .pair { display: grid; gap: 14px; max-width: 980px; margin: 0 auto; align-items: start; }
  @media (min-width: 760px) { .pair { grid-template-columns: 1fr 44px 1fr; } }
  .pside { display: grid; gap: 10px; justify-items: center; }
  .pshot { position: relative; width: 100%; border-radius: 10px; overflow: hidden; background: #222; border: 1px solid var(--line); box-shadow: var(--shadow); }
  .pshot :global(img) { display: block; width: 100%; height: auto; }
  .pshot.dim :global(img) { filter: grayscale(.6) brightness(.85); }
  .hl { position: absolute; border: 3px solid var(--mustard); border-radius: 8px; box-shadow: 0 0 0 999px rgba(0,0,0,.35); }
  .pshot.dim .hl { border-color: #e9e4dc; }
  .parr { width: 44px; height: 34px; align-self: center; justify-self: center; }
  @media (max-width: 759px) { .parr { transform: rotate(90deg); } }
  :global(.dg) p.pnote { margin: 0; width: 100%; background: var(--sheet); border: 1px solid var(--line); border-radius: 12px; padding: 10px 14px; font-size: 14.5px; line-height: 1.6; font-weight: 600; color: var(--muted); }
  :global(.dg) p.pnote.on { border: 2px solid var(--tone-ink); color: var(--ink); box-shadow: 3px 3px 0 color-mix(in srgb, var(--tone-ink) 25%, transparent); }
</style>
