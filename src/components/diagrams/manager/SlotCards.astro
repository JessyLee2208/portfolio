---
import Board from '../Board.astro';
import SlotCard from './SlotCard.astro';
import { langOf } from '../../../lib/i18n.js';
const en = langOf(Astro.url) === 'en';
---
<Board kicker="Before → After" title={en ? 'Time on top, type by color' : '時間放最上面，類型用顏色區分'} c="manager" label={en ? 'Slot cards before and after: the new card always shows the time and sold / capacity at the top, uses a solid color block for the slot type, and fades out when sold out' : '時段卡片改版前後：改版後最上面固定顯示時間與已售／上限，類型用整塊色塊區分，售完時變淡'}>
  <div class="ba">
    <div class="col">
      <p class="lab">{en ? 'Before' : '改版前'}</p>
      <div class="stack">
        <SlotCard old type="loop" name="循環設定" time="10:00" price="TWD 880" />
        <SlotCard old type="promo" name="限時促銷" time="10:30-11:30" price="TWD 880" />
        <SlotCard old type="special" name="特殊設定" time="10:00" price="TWD 880" />
        <SlotCard old type="pause" name="時段暫停" time="10:30-11:30" />
      </div>
    </div>
    <svg class="arrow-svg arr" viewBox="0 0 80 60" aria-hidden="true"><path d="M6 40 C 24 6, 56 6, 70 36 M60 30 L71 38 L74 25" /></svg>
    <div class="col">
      <p class="lab">{en ? 'After' : '改版後'}</p>
      <div class="grid2">
        <SlotCard type="loop" time="10:00-11:00" stock="0/40" name="循環設定" price="TWD 880" />
        <SlotCard type="loop" time="10:00-11:00" soldOut name="循環設定" price="TWD 880" />
        <SlotCard type="promo" time="10:00-11:00" stock="0/40" name="限時促銷" price="TWD 880" />
        <SlotCard type="promo" time="10:00-11:00" soldOut name="限時促銷" price="TWD 880" />
        <SlotCard type="special" time="10:00-11:00" stock="0/40" name="特殊設定" price="TWD 880" />
        <SlotCard type="special" time="10:00-11:00" soldOut name="特殊設定" price="TWD 880" />
        <SlotCard type="pause" time="10:00-11:00" name="時段暫停" />
      </div>
      <p class="legend"><span>{en ? 'On sale' : '可販售'}</span><span>{en ? 'Sold out' : '售完'}</span></p>
    </div>
  </div>
</Board>
<style>
  .ba { display: grid; gap: 20px; align-items: center; max-width: 900px; margin: 0 auto; }
  @media (min-width: 760px) { .ba { grid-template-columns: 220px 72px 1fr; } }
  .lab { font-weight: 900; color: var(--tone-ink); margin: 0 0 10px; text-align: center; }
  /* 改版前卡片跟改版後單張一樣寬（手機版不要撐滿整排） */
  .stack { display: grid; gap: 10px; max-width: 220px; width: 100%; margin: 0 auto; }
  .grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 10px; max-width: 460px; margin: 0 auto; }
  .legend { display: grid; grid-template-columns: 1fr 1fr; text-align: center; font-size: 13px; color: var(--muted); margin: 8px 0 0; }
  .arr { width: 64px; height: 48px; justify-self: center; }
  @media (max-width: 759px) {
    .arr { transform: rotate(90deg); }
    /* 手機版：時間和「售完」不要斷成兩行 */
    .grid2 :global(.slot .head) { padding: 6px 8px; gap: 4px; }
    .grid2 :global(.slot .head b) { font-size: 14px; white-space: nowrap; }
    .grid2 :global(.slot .head span) { font-size: 12px; }
    .grid2 :global(.slot .head em) { white-space: nowrap; font-size: 12px; padding: 2px 6px; }
  }
</style>
