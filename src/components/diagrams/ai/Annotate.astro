---
import Board from '../Board.astro';
import Cursor from '../Cursor.astro';
import { tr } from '../../../lib/en-dict.js';
const x = tr(Astro.url);
---
<Board kicker="Decision 3 · Annotate what AI checked" title={x('AI 查證過的內容，一律標出來')} c="ai"
  label={x('決策 3：spec 標註中，AI 查證過的技術結論標上來源，設計決定不標')}>
  <div class="wrap-a">
    <div class="panel">
      <p class="panel-title">Spec<small>{x('Figma 標註板')}</small></p>
      <div class="rows">
        <div class="note row"><span><span class="pill">1-1</span>　{x('沒有可用優惠時，整個區塊隱藏')}</span><span class="meta">{x('設計決定 · 不標')}</span></div>
        <div class="note row"><span><span class="pill">1-2</span>　{x('狀態值「0」在結帳頁代表不適用')}</span><span class="tagbox">{x('AI 查證：程式碼')}<svg class="ring" viewBox="0 0 200 60" preserveAspectRatio="none" aria-hidden="true"><ellipse cx="100" cy="30" rx="96" ry="26" transform="rotate(-3 100 30)" /></svg></span></div>
        <div class="note row"><span><span class="pill">1-3</span>　…</span></div>
      </div>
      <Cursor who="eng" label={x('後端')} class="cur-n" />
    </div>
    <p class="hand aside">{x('是「請複查」')}<br />{x('不是「可以相信」')}</p>
  </div>
</Board>
<style>
  .wrap-a { display: grid; gap: 20px; align-items: center; max-width: 960px; margin: 0 auto; }
  @media (min-width: 860px) { .wrap-a { grid-template-columns: 1fr 230px; } }
  .rows { margin-top: 16px; }
  .row { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: center; gap: 8px 16px; font-size: 16px; }
  .row .pill { margin: 0; }
  .meta { font: 400 12px var(--f-mono); color: var(--muted); }
  .tagbox { position: relative; font: 700 13px/1 var(--f-mono); border: 2px solid var(--ink); border-radius: 6px; padding: 6px 10px; }
  .ring { position: absolute; left: -18px; top: -12px; width: calc(100% + 36px); height: calc(100% + 24px); overflow: visible; }
  .ring ellipse { fill: none; stroke: var(--rust); stroke-width: 3.5; }
  p.aside.hand { white-space: nowrap; font-size: clamp(24px, 2.6vw, 28px); line-height: 1.35; text-align: center; transform: rotate(-4deg); margin: 0; }
  :global(.cur-n) { position: absolute; right: 16px; top: -18px; }
</style>
