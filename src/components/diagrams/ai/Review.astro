---
import Board from '../Board.astro';
import Cursor from '../Cursor.astro';
---
<Board kicker="Decision 1 · Review before handoff" title="把 refinement 會問的，先問完" c="ai"
  label="決策 1：交稿前先讓 AI 跑四項固定檢查，我逐條判斷後，改版後再複查">
  <div class="flow">
    <div class="panel main">
      <p class="panel-title">AI Review<small>每份 spec 都跑同一套</small></p>
      <div class="checks">
        <div class="note"><span class="pill">CHECK 01</span><br />票 × spec 逐條對照<span class="sub">✅ 對得上　⚠️ 對不上　❌ 稿上沒有</span></div>
        <div class="note"><span class="pill">CHECK 02</span><br />沒寫完整、有衝突<span class="sub">兩處寫法不同、分支只寫一半</span></div>
        <div class="note"><span class="pill">CHECK 03</span><br />少見的情況<span class="sub">載入／沒資料／失敗／極端值</span></div>
        <div class="note"><span class="pill">CHECK 04</span><br />跨品牌、跨頁面<span class="sub">改一個元件會不會影響別處</span></div>
      </div>
      <p class="hand judge">AI 列出來 → <span class="underline-hand">我逐條判斷</span>：真問題／要問人／AI 誤判</p>
      <Cursor who="ai" class="c-ai" />
    </div>
    <svg class="arrow-svg arr" viewBox="0 0 80 60" aria-hidden="true"><path d="M6 40 C 24 6, 56 6, 70 36 M60 30 L71 38 L74 25" /></svg>
    <div class="panel side">
      <p class="panel-title zh">改版後複查</p>
      <div class="notes">
        <div class="note"><span class="pill ok">✓</span> 已修好</div>
        <div class="note"><span class="pill">…</span> 還沒動</div>
        <div class="note"><span class="pill ai">NEW</span> 新帶進來</div>
      </div>
      <Cursor who="jessy" uid="cur-rv" class="c-me" />
    </div>
  </div>
</Board>
<style>
  .flow { display: grid; gap: 20px; align-items: center; max-width: 960px; margin: 0 auto; }
  @media (min-width: 860px) { .flow { grid-template-columns: 1fr 64px 240px; } }
  .checks { display: grid; gap: 10px; margin-top: 16px; }
  @media (min-width: 560px) { .checks { grid-template-columns: 1fr 1fr; } }
  .checks .note + .note { margin-top: 0; }
  .checks + p.judge { text-align: center; font-size: 19px; margin: 24px 0 4px; line-height: 1.5; text-wrap: balance; }
  .notes { margin-top: 14px; }
  .arr { width: 64px; height: 48px; justify-self: center; }
  @media (max-width: 859px) { .arr { transform: rotate(90deg); } }
  :global(.c-ai) { position: absolute; right: 12px; top: -18px; }
  :global(.c-me) { position: absolute; right: -8px; top: -22px; }
</style>
