---
import Board from '../Board.astro';
import Cursor from '../Cursor.astro';
import { tr } from '../../../lib/en-dict.js';
const x = tr(Astro.url);
---
<Board kicker="Decision 2 · Check values in the product" title={x('技術數值回產品查證，不靠記憶寫')} c="ai"
  label={x('決策 2：spec 上寫的 Eatigo 斷點 600px，產品實際是 768px')}>
  <div class="pair">
    <div class="panel">
      <p class="panel-title zh">{x('spec 上寫的')}<small>Eatigo breakpoint</small></p>
      <p class="big wrong display">600px
        <svg class="scribble" viewBox="0 0 320 90" preserveAspectRatio="none" aria-hidden="true"><path d="M5 60 C 80 20, 160 70, 230 30 S 300 40, 315 25" /></svg>
      </p>
    </div>
    <svg class="arrow-svg arr" viewBox="0 0 80 60" aria-hidden="true"><path d="M6 40 C 24 6, 56 6, 70 36 M60 30 L71 38 L74 25" /></svg>
    <div class="panel">
      <p class="panel-title zh">{x('產品實際的')}<small>actual value</small></p>
      <p class="big display">768px</p>
      <Cursor who="eng" label={x('前端')} class="cur-v" />
    </div>
  </div>
  <p class="hand hand-line">{x('漏寫的會被問，')}<span class="underline-hand">{x('寫錯的值只會被照做')}</span></p>
</Board>
<style>
  .pair { display: grid; gap: 16px; align-items: center; max-width: 820px; margin: 0 auto; }
  @media (min-width: 720px) { .pair { grid-template-columns: 1fr 72px 1fr; } }
  .big { position: relative; font-size: clamp(56px, 9vw, 84px); text-align: center; margin: 12px 0 0; font-variant-numeric: tabular-nums; }
  .wrong { color: var(--muted); }
  .scribble { position: absolute; left: 6%; top: 18%; width: 88%; height: 64%; }
  .scribble path { fill: none; stroke: var(--rust); stroke-width: 7; stroke-linecap: round; }
  .arr { width: 64px; height: 48px; justify-self: center; }
  @media (max-width: 719px) { .arr { transform: rotate(90deg); } }
  :global(.cur-v) { position: absolute; right: -6px; bottom: -20px; }
</style>
