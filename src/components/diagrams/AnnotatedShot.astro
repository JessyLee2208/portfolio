---
// 插畫式標註：在截圖上用手繪框圈出區域，說明小卡放旁邊，用手繪箭頭指過去
// regions 座標皆為圖片寬高的 %（x, y 左上角；w, h 寬高）
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Region { n: number; x: number; y: number; w: number; h: number; text: string; side: 'left' | 'right' | 'bottom'; }
interface Props { src: ImageMetadata; alt: string; regions: Region[]; widths?: number[]; sizes?: string; browser?: boolean; plain?: boolean; class?: string; }
// plain：說明小卡用原本的白卡＋陰影（不描邊、不加粗），Manager 用（11/10 Jessy）
const { src, alt, regions, widths = [480, 960], sizes = '420px', browser = false, plain = false, class: cls = '' } = Astro.props;
// 手繪感的圓角框（用 path 畫，四邊稍微不直）
const box = (r: Region) => {
  const { x, y, w, h } = r; const k = 1.2;
  return `M${x + k} ${y} C ${x + w * .3} ${y - .4}, ${x + w * .7} ${y + .3}, ${x + w - k} ${y} Q ${x + w} ${y}, ${x + w} ${y + k} ` +
    `C ${x + w + .3} ${y + h * .3}, ${x + w - .3} ${y + h * .7}, ${x + w} ${y + h - k} Q ${x + w} ${y + h}, ${x + w - k} ${y + h} ` +
    `C ${x + w * .7} ${y + h + .4}, ${x + w * .3} ${y + h - .3}, ${x + k} ${y + h} Q ${x} ${y + h}, ${x} ${y + h - k} ` +
    `C ${x - .3} ${y + h * .7}, ${x + .3} ${y + h * .3}, ${x} ${y + k} Q ${x} ${y}, ${x + k + .4} ${y - .2}`;
};
---
<div class:list={['ashot', { plain }, cls]}>
  <div class:list={['frame', { browser }]}>
    {browser && <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>}
    <div class="img">
      <div class="pic">
        <Image src={src} alt={alt} widths={widths} sizes={sizes} />
        <svg class="marks" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
          {regions.map((r) => <path d={box(r)} />)}
        </svg>
        {regions.map((r) => <i class="tag" style={`left:${r.x + r.w}%; top:${r.y}%`}>{r.n}</i>)}
      </div>
      {regions.map((r) => (
        <div class:list={['call', `side-${r.side}`]} style={r.side === 'bottom' ? `left:${r.x + r.w / 2}%` : `top:${r.y + r.h / 2}%`}>
          {r.side === 'bottom'
            ? <svg class="arw up" viewBox="0 0 30 64" aria-hidden="true"><path d="M15 60 C 6 44, 24 26, 15 6 M8 15 L15 4 L22 15" /></svg>
            : <svg class="arw" viewBox="0 0 60 30" aria-hidden="true"><path d="M4 22 C 18 6, 38 4, 54 14 M45 8 L55 14 L47 22" /></svg>}
          <p><b>{r.n}</b>{r.text}</p>
        </div>
      ))}
    </div>
  </div>
</div>
<style>
  .ashot { position: relative; }
  .frame { position: relative; border-radius: 12px; background: #fff; box-shadow: var(--shadow); border: 1px solid var(--line); }
  .frame.browser { overflow: visible; }
  .bar { height: 24px; background: #f1ede6; display: flex; align-items: center; gap: 6px; padding: 0 12px; border-radius: 12px 12px 0 0; }
  .bar i { width: 8px; height: 8px; border-radius: 50%; background: #d8cfc2; }
  .img { position: relative; }
  /* 框線只量截圖本身（手機版說明卡排在下面時，框才不會被拉長蓋到說明卡） */
  .pic { position: relative; }
  .img :global(img) { width: 100%; display: block; border-radius: 0 0 12px 12px; }
  .frame:not(.browser) .img :global(img) { border-radius: 12px; }
  .marks { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; pointer-events: none; }
  .marks path { fill: color-mix(in srgb, var(--tone) 10%, transparent); stroke: var(--tone-ink); stroke-width: 2.6; stroke-linejoin: round; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .tag { position: absolute; transform: translate(-50%, -50%); font-style: normal; width: 22px; height: 22px; border-radius: 50%; background: var(--tone-ink); color: #fff; font: 700 12px/22px var(--f-mono); text-align: center; box-shadow: 0 0 0 2px var(--sheet); }

  /* 說明小卡 */
  .call { position: absolute; width: 170px; display: flex; align-items: center; gap: 4px; }
  /* 說明小卡要跟白色截圖分開：案例主色描邊＋字加粗，看起來是貼上去的註解 */
  .call p { margin: 0; background: var(--sheet); border: 2px solid var(--tone-ink); border-radius: 12px; padding: 10px 12px; font-size: 13.5px; font-weight: 600; line-height: 1.6; box-shadow: 3px 3px 0 color-mix(in srgb, var(--tone-ink) 25%, transparent); }
  .call b { display: inline-grid; place-items: center; width: 18px; height: 18px; margin-right: 6px; border-radius: 50%; background: var(--tone-ink); color: #fff; font: 700 12px/1 var(--f-mono); vertical-align: 1px; }
  .plain .call p { border: 0; font-weight: 400; box-shadow: var(--shadow); }
  .plain .arw path { stroke: var(--ink); stroke-width: 2.4; }
  .arw { width: 44px; flex: none; overflow: visible; }
  .arw path { fill: none; stroke: var(--tone-ink); stroke-width: 2.6; stroke-linecap: round; stroke-linejoin: round; }
  .side-left { right: calc(100% + 6px); transform: translateY(-50%); flex-direction: row-reverse; }
  .side-left .arw { transform: none; }
  .side-right { left: calc(100% + 6px); transform: translateY(-50%); }
  .side-right .arw { transform: scaleX(-1); }
  .side-bottom { top: calc(100% + 4px); transform: translateX(-50%); flex-direction: column; width: 220px; gap: 2px; }
  .arw.up { width: 22px; }

  /* 窄螢幕：小卡改排在截圖下面 */
  /* 說明卡移到白框外面，跟截圖分開 */
  @media (max-width: 999px) {
    .frame, .frame.browser { background: none; border: 0; box-shadow: none; }
    .pic { background: #fff; border: 1px solid var(--line); border-radius: 12px; box-shadow: var(--shadow); }
    .frame.browser .pic { border-radius: 0 0 12px 12px; border-top: 0; }
    .call { position: static; transform: none; width: auto; margin-top: 12px; }
    .call .arw { display: none; }
    .img { display: flow-root; }
  }
</style>
