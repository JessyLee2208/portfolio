---
// 首頁開場：沒有卡片，文字在左；Jessy 手繪的探頭圖貼在畫面最右邊，跟文字放同一列
// 互動：點一下換表情＋換對話；2.5 秒內連點 5 下會生氣；電腦版頭會往游標方向歪
import Avatar from './Avatar.astro';
interface Props { lines?: string[]; }
const {
  lines = ["Hi, I'm Jessy 👋", '要看我的作品嗎？', '作品在下面喔 👇', '我是產品設計師 ✏️', '再戳一下試試看？'],
} = Astro.props;
---
<section class="hero-peek" data-lines={JSON.stringify(lines)}>
  <div class="wrap row">
    <div class="text"><slot /></div>
  </div>
  <div class="peeker">
    <p class="speech" aria-live="polite">{lines[0]}</p>
    <div class="lean"><div class="tilt"><Avatar size={300} expr={1} full interactive cycle={[1, 2, 3, 4, 0]} /></div></div>
  </div>
</section>

<style>
  .hero-peek { position: relative; overflow-x: clip; --av: 300px; }
  .row { min-height: 440px; display: flex; align-items: center; padding-block: 48px; }
  .text { max-width: min(760px, calc(100% - 240px)); position: relative; z-index: 1; }

  /* 小人：貼在畫面最右邊，手臂超出畫面一點；垂直置中對齊文字 */
  .peeker {
    position: absolute; right: 0; top: 50%; width: var(--av);
    transform: translate(26%, -48%); animation: peek-in 1s cubic-bezier(.3, 1.3, .5, 1) .2s both;
  }
  /* 往左歪著探進來（只歪圖，對話泡泡不跟著歪） */
  .lean { transform: rotate(-14deg); transform-origin: 90% 95%; }
  .tilt { transform-origin: 60% 80%; transition: transform .35s ease-out; }
  /* 頭像尺寸跟著 --av 走（手機版會縮小） */
  .peeker :global(.avatar) { width: var(--av) !important; height: calc(var(--av) * 564 / 500) !important; }
  .peeker :global(.avatar img) { width: 100% !important; }

  /* 對話泡泡：在臉的左邊，右邊小尾巴往右指向嘴巴 */
  .speech {
    --bc: #2a211c;
    position: absolute; right: calc(var(--av) * .98); top: 37%; margin: 0; white-space: nowrap; z-index: 2;
    background: #fffdf9; color: #2a211c; font-weight: 700; font-size: 15px; line-height: 1;
    padding: 11px 16px; border: 2.4px solid var(--bc); border-radius: 14px; transform-origin: right center;
    animation: bubble-in .4s cubic-bezier(.3, 1.6, .5, 1) 1.1s both;
  }
  /* 尾巴：外層三角形畫框線顏色，內層三角形用泡泡底色蓋掉接縫，看起來跟泡泡是一體的 */
  .speech::before, .speech::after {
    content: ''; position: absolute; top: 50%; transform: translateY(-50%);
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .speech::before { right: -14px; width: 14px; height: 20px; background: var(--bc); }
  .speech::after { right: -9.9px; width: 12.3px; height: 17.5px; background: #fffdf9; }
  /* 電腦版：泡泡放在小人頭的上方，尾巴朝下指向頭（11/10 Jessy：放旁邊會壓到介紹文字） */
  @media (min-width: 761px) {
    .speech { right: auto; left: 2%; top: auto; bottom: 91%; transform-origin: 70% bottom; }
    .speech::before, .speech::after { top: auto; left: 70%; clip-path: polygon(0 0, 100% 0, 50% 100%); }
    .speech::before { right: auto; bottom: -14px; width: 20px; height: 14px; transform: translateX(-50%); }
    .speech::after { right: auto; bottom: -9.9px; width: 17.5px; height: 12.3px; transform: translateX(-50%); }
  }
  .speech.swap { animation: bubble-in .35s cubic-bezier(.3, 1.6, .5, 1) both; }
  .speech.angry { --bc: var(--rust); color: var(--rust); }

  /* 窄螢幕：小人縮小，放在文字上方右側 */
  @media (max-width: 760px) {
    .hero-peek { --av: 170px; }
    /* 小人身體下緣跟標題只留一點空隙（11/10 Jessy：手機版小人跟標題離太遠） */
    .row { min-height: 0; padding-top: calc(var(--av) * .96); }
    .text { max-width: 100%; }
    .peeker { top: 0; transform: translate(28%, 4%); animation-name: peek-in-sm; }
    .lean { transform: rotate(-12deg); }
    .speech { font-size: 14px; top: 30%; right: calc(var(--av) * 1.02); }
  }

  @keyframes peek-in { from { opacity: 0; transform: translate(60%, -50%) rotate(12deg); } to { opacity: 1; transform: translate(26%, -48%); } }
  @keyframes peek-in-sm { from { opacity: 0; transform: translate(60%, 0) rotate(12deg); } to { opacity: 1; transform: translate(28%, 4%); } }
  @keyframes bubble-in { from { opacity: 0; transform: scale(.6) translateY(6px); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .peeker, .speech, .speech.swap { animation: none; } .tilt { transition: none; } }
</style>

<script>
  document.querySelectorAll<HTMLElement>('.hero-peek').forEach((root) => {
    const lines: string[] = JSON.parse(root.dataset.lines || '[]');
    const speech = root.querySelector<HTMLElement>('.speech')!;
    const tilt = root.querySelector<HTMLElement>('.tilt')!;
    const face = root.querySelector<HTMLElement>('.avatar')!;
    let line = 0;
    let pokes: number[] = [];
    let angry = false;

    const say = (text: string, isAngry = false) => {
      speech.textContent = text;
      speech.classList.toggle('angry', isAngry);
      speech.classList.remove('swap'); void speech.offsetWidth; speech.classList.add('swap');
    };

    // 點一下換對話；連點 5 下會生氣
    root.addEventListener('avatar:poke', () => {
      if (angry) { face.dataset.expr = '5'; return; }
      const now = Date.now();
      pokes = pokes.filter((t) => now - t < 2500).concat(now);
      if (pokes.length >= 5) {
        angry = true; pokes = [];
        face.dataset.expr = '5';
        say('不要再戳了啦！😤', true);
        setTimeout(() => { angry = false; face.dataset.expr = '2'; say('好啦，原諒你 😉'); }, 2000);
        return;
      }
      line = (line + 1) % lines.length;
      say(lines[line]);
    });

    // 電腦版：頭往游標方向微微歪
    const canHover = window.matchMedia('(hover: hover)').matches;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (canHover && !reduce) {
      let raf = 0;
      window.addEventListener('mousemove', (e) => {
        cancelAnimationFrame(raf);
        raf = requestAnimationFrame(() => {
          const r = tilt.getBoundingClientRect();
          const dx = e.clientX - (r.left + r.width / 2);
          const dy = e.clientY - (r.top + r.height / 2);
          const near = Math.hypot(dx, dy) < 700;
          const deg = near ? Math.max(-10, Math.min(10, dx / 30)) : 0;
          const lift = near ? Math.max(-6, Math.min(0, dy / 60)) : 0;
          tilt.style.transform = `rotate(${deg}deg) translateY(${lift}px)`;
        });
      });
    }
  });
</script>
