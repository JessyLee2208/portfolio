  label={en ? 'myVideo member center redesign (2020) cover: the redesigned account settings page' : 'myVideo 會員中心改版（2020）封面：改版後的帳號設定頁'}>
  <Image src={screen} alt="" widths={[640, 1000]} sizes="(min-width: 820px) 300px, 60vw" />
</ArchiveCover>
