---
import '../../styles/diagram.css';
import CoverB from './CoverB.astro';
import { langOf } from '../../lib/i18n.js';
const en = langOf(Astro.url) === 'en';
const c = en
  ? { title: 'Rethinking design<br />handoff with AI', sub: 'AI catches everything; I judge each item', bigLabel: 'Open questions found per spec in the first pass (avg.)', label: 'Rethinking design handoff with AI, cover: a spec annotation where AI-verified content is flagged', small: 'Figma annotations', n1: 'Hide when no offer applies', n2: 'Status “0” = not applicable', ai: 'AI-verified' }
  : { title: '用 AI 改造<br />設計交付流程', sub: 'AI 找得全，我再逐條判斷', bigLabel: '第一輪平均每份 spec 找出的待確認點', label: '用 AI 改造設計交付流程封面：spec 標註上，AI 查證過的內容被標出來', small: 'Figma 標註板', n1: '沒有可用優惠時隱藏', n2: '狀態值「0」＝不適用', ai: 'AI 查證' };
---
<CoverB tone="mustard" pattern="lines" shape="arch" accent="sparkle-loop" under="wave" no="03" kick="Design Ops · AI" title={c.title}
  sub={c.sub} big="~36" bigLabel={c.bigLabel}
  label={c.label}>
  <div class="panel spec">
    <p class="t">Spec<small>{c.small}</small></p>
    <div class="note"><span class="pill">1-1</span>{c.n1}</div>
    <div class="note"><span class="pill">1-2</span>{c.n2}<span class="ai">{c.ai}</span></div>
    <div class="note"><span class="pill">1-3</span>…</div>
  </div>
</CoverB>
<style>
  .spec { width: 30cqw; padding: 2cqw; border-radius: 2cqw; transform: rotate(-4deg); box-shadow: 0 3cqw 5cqw -3cqw rgba(0,0,0,.3); }
  .t { font: 700 2.4cqw/1.1 var(--f-mono); text-align: center; margin: 0 0 1.6cqw; }
  .t small { display: block; font: 400 1.2cqw/1.4 var(--f-mono); color: var(--muted); margin-top: .4cqw; }
  .note { display: flex; align-items: center; gap: .9cqw; font-size: 1.45cqw; padding: 1cqw 1.2cqw; border-radius: .9cqw; border-width: 1.5px; box-shadow: -.5cqw .5cqw 0 var(--line); white-space: nowrap; }
  .note + .note { margin-top: 1cqw; }
  .pill { font-size: 1cqw; padding: .45cqw .7cqw; margin: 0; flex: none; }
  .ai { margin-left: auto; font: 700 1.1cqw/1 var(--f-mono); background: var(--rust); color: #fff; padding: .5cqw .8cqw; border-radius: .5cqw; }
</style>
