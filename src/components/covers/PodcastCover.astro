---
// MyMusic Podcast 封面（舊作）：檔案封套風，畫面用 prototype 錄影的 Podcast 首頁
import { Image } from 'astro:assets';
import ArchiveCover from './ArchiveCover.astro';
import screen from '../../assets/cases/podcast/screen.jpg';
import { langOf } from '../../lib/i18n.js';
const en = langOf(Astro.url) === 'en';
---
<ArchiveCover year="2020" org="TAIWAN MOBILE"
  title="MyMusic<br />Podcast"
  meta={en ? 'App · UI/UX lead · Usability test' : 'App · UI/UX 主責 · 易用性測試'}
  label={en ? 'MyMusic Podcast (2020) cover: the podcast home screen' : 'MyMusic Podcast（2020）封面：Podcast 首頁畫面'}>
  <Image src={screen} alt="" widths={[284]} sizes="200px" />
</ArchiveCover>
