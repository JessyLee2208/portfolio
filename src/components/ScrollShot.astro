---
// 太長的網頁截圖：放進固定高度的視窗框，在框裡上下滑動看完整頁面（11/10 Jessy：過長的頁面都改成可以滑動）
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; ratio?: string; wide?: boolean; }
const { src, alt, caption, ratio = '1440 / 900', wide = false } = Astro.props;
---
<figure class:list={['ss', 'reveal', { wide }]}>
  <div class="win">
    <div class="bar" aria-hidden="true"><i></i><i></i><i></i></div>
    <div class="view" style={`aspect-ratio: ${ratio}`} tabindex="0" aria-label={`${alt}（可以上下捲動看完整頁面）`}>
      <Image src={src} alt={alt} widths={[700, 1100, 1600]} sizes={wide ? '(max-width: 1120px) 100vw, 1088px' : '(max-width: 760px) 100vw, 720px'} loading="lazy" />
    </div>
    <span class="hint" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M12 4v16M7 9l5-5 5 5M7 15l5 5 5-5" /></svg>在畫面裡滑動</span>
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .ss { margin: 32px 0; }
  @media (min-width: 900px) and (max-width: 1079px) { .ss.wide { width: min(1088px, calc(100vw - 2 * var(--gutter))); margin-left: 50%; transform: translateX(-50%); } }
  @media (min-width: 1080px) { .ss.wide { width: calc(100% + 80px); margin-left: -40px; } }
  .win { position: relative; border-radius: var(--radius); overflow: hidden; border: 1px solid var(--line); background: #fff; }
  .bar { height: 26px; background: #f1ede6; display: flex; align-items: center; gap: 6px; padding: 0 12px; border-bottom: 1px solid var(--line); }
  .bar i { width: 9px; height: 9px; border-radius: 50%; background: #d8cfc2; }
  .view { overflow-y: auto; overscroll-behavior: contain; scrollbar-width: thin; }
  .view :global(img) { display: block; width: 100%; height: auto; }
  .hint { position: absolute; right: 12px; bottom: 12px; display: inline-flex; align-items: center; gap: 4px; background: var(--ink); color: var(--paper); font-size: 12px; font-weight: 700; padding: 6px 10px 6px 8px; border-radius: 99px; pointer-events: none; box-shadow: 0 6px 14px -6px rgba(0,0,0,.5); animation: nudge 2.4s ease-in-out infinite; transition: opacity .3s; }
  .hint svg { width: 14px; height: 14px; fill: none; stroke: currentColor; stroke-width: 2.4; stroke-linecap: round; stroke-linejoin: round; }
  .win:hover .hint, .win:focus-within .hint { opacity: 0; }
  @keyframes nudge { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-4px); } }
  @media (prefers-reduced-motion: reduce) { .hint { animation: none; } }
  figcaption { margin-top: 10px; font-size: 13px; color: var(--muted); text-align: center; }
</style>
