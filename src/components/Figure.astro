---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
interface Props { src: ImageMetadata; alt: string; caption?: string; wide?: boolean; gif?: boolean; }
// gif 要明講：不要去讀 src.format，讀了 Astro 會把原圖（常常好幾 MB）也一起輸出
const { src, alt, caption, wide = false, gif: isGif = false } = Astro.props;
---
<figure class:list={['fig', { wide }]}>
  <div class="reveal">
    {isGif
      ? <img src={src.src} width={src.width} height={src.height} alt={alt} loading="lazy" />
      : <Image src={src} alt={alt} widths={[640, 1000, 1600]} sizes={wide ? '(max-width: 1120px) 100vw, 1088px' : '(max-width: 760px) 100vw, 720px'} loading="lazy" />}
  </div>
  {caption && <figcaption>{caption}</figcaption>}
</figure>
<style>
  .fig { margin: 32px 0; }
  .fig img { width: 100%; border-radius: var(--radius); border: 1px solid var(--line); background: var(--sheet); }
  figcaption { margin-top: 10px; font-size: 13px; color: var(--muted); text-align: center; }
  @media (min-width: 900px) {
    .fig.wide { width: min(1088px, calc(100vw - 2 * var(--gutter))); margin-left: 50%; transform: translateX(-50%); }
  }
</style>
